# Environment variables for sanzaru MCP server
#
# USAGE:
#
# 1. For MCP servers (Claude Code):
#    Set these as template variables in .mcp.json:
#      "env": {
#        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
#        "VIDEO_PATH": "${VIDEO_PATH}",
#        ...
#      }
#
# 2. For local development with .env files:
#    a) Copy this file to .env and fill in your values
#    b) Install dotenv: uv add --dev python-dotenv
#    c) Run with dotenv-cli: npx dotenv-cli -- claude
#       (or use bunx dotenv-cli -- claude)
#
# This approach avoids implicit .env loading by uv and makes configuration explicit.

# Required
OPENAI_API_KEY="your-openai-api-key-here"

# Optional: second TTS provider for create_audio / generate_podcast.
# Requires the extra: uv pip install 'sanzaru[elevenlabs]'
# ELEVENLABS_API_KEY="your-elevenlabs-api-key-here"
# ElevenLabs caps concurrent requests per subscription tier (2-15, or 4-30 on
# Flash/Turbo). The defaults are the Free-tier caps — 2, or 4 on Flash/Turbo —
# where a 3rd concurrent eleven_v3 request already returns HTTP 429. Raise this
# on a paid tier; lower it if renders still hit 429.
# SANZARU_ELEVENLABS_MAX_CONCURRENCY=2

# Optional: simulated podcasts (sanzaru podcast simulate) — realtime agents
# conversing. Needs only OPENAI_API_KEY plus the [audio] extra.
#
# Concurrent Realtime sessions across all acts. Each act opens one per host, so
# this caps parallelism at (sessions / hosts) acts. Default 6 is deliberately
# conservative — the account ceiling is not published. Raise once you know yours.
# SANZARU_REALTIME_MAX_SESSIONS=6
#
# Wall clock one turn may take before the act is declared stalled and fails
# (its finished acts stay checkpointed). Default: 6x --turn-seconds, min 60s.
# SANZARU_REALTIME_TURN_TIMEOUT=120
#
# Wall clock one ACT may take before the producer lands it early rather than
# risk the Realtime session's 60-minute close mid-act. Default: 3000s.
# SANZARU_REALTIME_ACT_BUDGET=3000
#
# Override stale list pricing without waiting for a release. Six USD-per-1M
# values: text_in,cached_text_in,audio_in,cached_audio_in,audio_out,text_out
# SANZARU_REALTIME_PRICE_GPT_REALTIME_2_1=4,0.4,32,0.4,64,24

# Media storage — set ONE of the following:
#
# Option 1 (recommended): single root directory (auto-creates videos/, images/, audio/)
SANZARU_MEDIA_PATH="/absolute/path/to/media"
#
# Option 2 (legacy): individual paths — these override SANZARU_MEDIA_PATH when set
# VIDEO_PATH="/absolute/path/to/videos"
# IMAGE_PATH="/absolute/path/to/images"
# AUDIO_PATH="/absolute/path/to/audio"

# Optional: Defaults to INFO if not set
# LOG_LEVEL="INFO"
